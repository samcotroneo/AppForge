{
  "name": "@samcotroneo/appforge",
  "private": false,
  "version": "0.1.0",
  "description": "Agent-friendly Capacitor + Ionic React + Tailwind + KonstaUI PWA template.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "appforge": "./bin/appforge.js"
  },
  "files": [
    "bin",
    ".github",
    ".gitignore",
    "CLAUDE.md",
    "README.md",
    "capacitor.config.ts",
    "docs",
    "eslint.config.js",
    "index.html",
    "package-lock.json",
    "public",
    "src",
    "tsconfig.app.json",
    "tsconfig.json",
    "tsconfig.node.json",
    "vite.config.ts"
  ],
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest",
    "test:unit": "vitest run --reporter dot --run",
    "prepublishOnly": "npm run lint && npm run test:unit && npm run build",
    "cap:sync": "npm run build && npx cap sync"
  },
  "dependencies": {
    "@capacitor/core": "8.4.1",
    "@ionic/react": "8.8.13",
    "@ionic/react-router": "8.8.13",
    "ionicons": "7.4.0",
    "konsta": "5.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "5.3.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.1",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.2",
    "@types/node": "24.13.2",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@types/react-router-dom": "5.3.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.7.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.2",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.4",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  }
}
