{
  "name": "appforge-template",
  "private": true,
  "version": "0.1.0",
  "description": "Agent-friendly Capacitor + SolidJS + Tailwind + DaisyUI PWA template.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest",
    "test:unit": "vitest run --reporter dot --run",
    "cap:sync": "npm run build && npx cap sync"
  },
  "dependencies": {
    "@capacitor/core": "8.4.1",
    "solid-js": "1.9.14"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.1",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.2",
    "@types/node": "24.13.2",
    "daisyui": "5.6.16",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.2",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.4",
    "vite-plugin-pwa": "1.3.0",
    "vite-plugin-solid": "2.11.12",
    "vitest": "4.1.10"
  }
}
